<?php

/**
 * @file
 * Tests for Legal module.
 */

/**
 * Legal module base test class.
 */
class LegalTestCase extends BackdropWebTestCase {
  protected $edit;

  /**
 *
 */
  function setUp() {
    // Enable any modules required for the test.
    parent::setUp('legal');

    // Set basic module settings.
    $this->edit = array(
      'conditions[value]'  => $this->randomName(),
      'conditions[format]' => 'plain_text',
    );

    // Ensure registration is enabled.
    config_set('system.core', 'user_register', USER_REGISTER_VISITORS_ADMINISTRATIVE_APPROVAL);

  }

  /**
   * Set module settings. This can only be called once from each test case
   * instance.
   */
  function setSettings($edit) {
    // Had to move to creating an user for every change in settings, since
    // creating this in setUp() was not working.
    $admin_user = $this->backdropCreateUser(array('administer terms and conditions'));

    $this->backdropLogin($admin_user);

    $this->backdropPost('admin/config/people/legal', $edit, t('Save'));

    // Check account wasn't created.
    $this->assertText(t('Terms and conditions have been saved.'), 'T&C text setup correctly');

    // Log user out.
    $this->backdropLogout();
  }
}

/**
 * Test registering as new user and creating an account.
 */
class LegalRegisterTestCase extends LegalTestCase {

  /**
 *
 */
  function setUp() {
    parent::setUp();

    $this->setSettings($this->edit);
  }

  /**
   * Accept T&C to successfully create an account.
   */
  function testRegisterSuccessful() {
    // Prepare a user to do testing.
    $name = $this->randomName();
    $mail = "$name@example.com";
    $edit = array(
      'name' => $name,
      'mail' => $mail,
      'legal_accept' => TRUE,
    );
    $this->backdropPost('user/register', $edit, t('Create new account'));

     // Check account was created.
    $this->assertText(t('Thank you for applying for an account. Your account is currently pending approval by the site administrator.'), 'Account created');
  }

  /**
   * Don't accept T&C no account created.
   */
  function testRegisterUnsuccessful() {
    // Prepare a user to do testing.
    $name = $this->randomName();
    $mail = "$name@example.com";
    $edit = array(
      'name' => $name,
      'mail' => $mail,
    );

    $this->backdropPost('user/register', $edit, t('Create new account'));

     // Check account wasn't created.
    $this->assertText(t('Accept Terms and conditions of use field is required.'), 'T&C not accepted, account not created');
  }

}

/**
 * Test registering as new user and creating an account.
 */
class LegalPasswordResetTestCase extends LegalTestCase {

  /**
   * Ordinary user for testing password reset.
   */
  public $user;

  /**
 *
 */
  function setUp() {
    parent::setUp();
    $this->setSettings($this->edit);

    // Create an ordinary user.
    $this->user = $this->backdropCreateUser();
  }

  /**
   * Accept T&C to successfully create an account.
   */
  function testPasswordReset() {
    // Create a log in link for the user, and go to that URL.
    // Borrowed from testUserPasswordResetExpired().
    $timestamp = REQUEST_TIME;
    $this->backdropGet("user/reset/{$this->user->uid}/$timestamp/" . user_pass_rehash($this->user->pass, $timestamp, $this->user->login, $this->user->uid));
    $this->assertText(t("Please enter a new password to access your account."), "The user is shown the message to reset their password.");
    $this->assertText(t('Reset password'), "The reset password form is shown.");

    // Use the one-time login link.
    $this->backdropPost(NULL, array('pass' => 'newpassword'), t('Save password & log in'));

    $this->assertTitle(t('Terms and Conditions | Backdrop CMS'), "The user is redirected to the terms and conditions approval page.");
    $this->assertText(t('Terms and Conditions'), "The Terms and Conditions form is shown.");
    // assertText() doesn't handle an '&' properly.
    $this->assertText(t('To continue to use this site please read the Terms and conditions below'), "The Terms and Conditions form is shown.");

    $edit = array(
      'legal_accept' => TRUE,
    );

    // Accept the T&Cs.
    $this->backdropPost(NULL, $edit, t('Confirm'));

  }

}

/**
 * Test Scroll Box Display.
 */
class LegalScrollBoxDisplayTestCase extends LegalTestCase {

  /**
 *
 */
  function setUp() {
    parent::setUp();

    // Set basic module settings.
    $this->edit['display'] = 0;
    $this->setSettings($this->edit);
  }

  /**
   * Test "Scroll Box" display.
   */
  function testScrollBoxDisplay() {
    $this->backdropGet('user/register');

     // Check presence of T&C text.
    $this->assertText($this->edit['conditions[value]'], 'T&C text displayed');
  }
}

